{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "devicemigration-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@c8y/devkit:build",
          "options": {
            "outputPath": "dist/devicemigration-ui",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@c8y/devkit:dev-server",
          "options": {
            "buildTarget": "devicemigration-ui:build",
            "shell": "administration"
          },
          "configurations": {
            "production": {
              "buildTarget": "devicemigration-ui:build:production"
            }
          }
        },
        "deploy": {
          "builder": "@c8y/devkit:deploy",
          "options": {}
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
