# Server managed properties which must not be sent back when recreating a
# managed object. Parent and child collections are rebuilt from the exported
# relationship files instead, since the IDs differ in the target tenant.
STRIP_PROPERTIES='del(
    .id, .self, .lastUpdated, .creationTime, .owner,
    .childDevices, .childAssets, .childAdditions,
    .deviceParents, .assetParents, .additionParents,
    .c8y_Availability, .c8y_ActiveAlarmsStatus, .c8y_Connection
)'

# Old ID to new ID mapping, kept as a tab separated file because macOS still
# ships bash 3.2 which has no associative arrays
idMap=""

# Extra arguments passed to every c8y call which modifies data, set from --force
forceArgs=()

# External identities created, and those the target tenant refused
identitiesCreated=0
identitiesFailed=0

# Where the old to new ID mapping is written
mappingFile=""

# --dataOnly, resolved once. The mapping is pure input in that mode, so it must
# never be rewritten: an earlier version of this truncated it to {} at startup
# and took the revert record with it.
dataOnly=false

# --resume, resolved once
resume=false

# How many devices --dataOnly actually imported data for
dataDevices=0

# The marker fragment added to every created managed object, empty when the
# migration is not being tracked. The run identity lives in the fragment NAME
# rather than its body, which is what makes it findable with one indexed
# --fragmentType query instead of a scan.
markerFragment=""

# The run id actually in effect, which is either --runId or a generated one
markerRunId=""

# Device data recreated in the target tenant
measurementsCreated=0
eventsCreated=0
alarmsCreated=0
binariesCreated=0

# Records that were meant to arrive and did not. The commands below deliberately
# keep going after one fails, so that a single bad record does not cost the whole
# migration - but the exit code has to say so at the end. Reporting success while
# records are missing is how a migration silently loses data, and it also lets
# migrate journal a device as finished when it is not.
dataFailures=0

# Deliberately conservative. A migration should not be the reason a tenant
# starts throttling, and measurements go in the smallest batches because they
# are by far the highest volume and the collection POST carries the largest
# body. Cumulocity's relevant caps are a recommended 1 MB document, a soft
# 1000-element array and a hard five minute request duration; 50 sits well
# inside all three.
MEASUREMENT_BATCH_SIZE=50
DATA_WORKERS=2
DATA_DELAY=200ms

# QUIESCENT persists the record while suppressing realtime notifications. It is
# documented as applying to measurements and events only: alarm creation is
# always PERSISTENT whatever this header says. TRANSIENT and CEP must never be
# used here, as neither persists the data.
DATA_PROCESSING_MODE=QUIESCENT

# Cumulocity rejects fragment names containing whitespace or special
# characters, so the run id has to be letters, digits and underscores. Checked
# here rather than trusted, because a rejected name would fail on every single
# object rather than once.
# A run id is generated when none was given, so every import can be found again
# by its marker rather than only through the mapping file. --noFlag opts out.
generate_run_id() {
    local stamp random
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    random=$(LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 6)
    printf '%s_%s' "$stamp" "$random"
}

resolve_marker_fragment() {
    local runId="$1" noFlag="$2"

    if [[ "$noFlag" == "true" ]]; then
        return 0
    fi
    if [[ -z "$runId" ]]; then
        runId=$(generate_run_id)
    fi

    case "$runId" in
        *[!A-Za-z0-9_]*)
            echo "Invalid --runId '$runId': letters, digits and underscores only," >&2
            echo "because it becomes part of a Cumulocity fragment name." >&2
            exit 1
            ;;
    esac

    markerRunId="$runId"
    markerFragment="c8y_DeviceMigration_$runId"
}

# Rewrite the mapping from the running record. Called after every created
# object rather than once at the end, because an import that dies part way
# through is precisely the case `revert` has to be able to clean up: a mapping
# written only on success would leave those objects orphaned in the tenant.
write_mapping() {
    if [[ "$dataOnly" == "true" ]]; then
        return 0
    fi

    jq -R -s 'split("\n")
        | map(select(length > 0) | split("\t"))
        | map({(.[0]): .[1]})
        | add // {}' "$idMap" > "$mappingFile"
}

lookup_new_id() {
    awk -F'\t' -v old="$1" '$1 == old { print $2; exit }' "$idMap"
}

lookup_name() {
    awk -F'\t' -v old="$1" '$1 == old { print $3; exit }' "$idMap"
}

# Name of a managed object as it appears in the export, for logging only
read_name() {
    local name
    # -j so no trailing newline is turned into a trailing space by tr
    name=$(jq -rj '.name // empty' "$1" | tr '\t\n' '  ')
    if [[ -z "${name// /}" ]]; then
        name="<unnamed>"
    fi
    printf '%s' "$name"
}

plural() {
    if [[ "$1" -eq 1 ]]; then
        printf '%s' "$2"
    else
        printf '%s' "$3"
    fi
}

# Server managed properties removed with jq before the record is handed to c8y.
#
# NOT a jsonnet --template, deliberately. When a record is piped into a create
# command, go-c8y-cli inlines it into the jsonnet program as source text
# (`local input = ... + {value: {...record...}};`). A record whose text carries
# escaped quotes and backslashes - a JSON payload stored inside a JSON string,
# which real alarms do contain - can then fail to lex, and the whole import dies
# with "Could not lex the character". Passing the cleaned record as --data with
# --nullInput means nothing is ever inlined into jsonnet, so the content cannot
# break the request no matter how it is escaped.
#
# source is dropped here as well: --device supplies the new source.id, and
# removing it means the source tenant's self link cannot leak through.
EVENT_STRIP_JQ='del(.id, .self, .creationTime, .lastUpdated, .c8y_IsBinary, .source)'

# count, firstOccurrenceTime and history are dropped deliberately: that is the
# "current status only, not the full history" requirement, and none of them are
# settable through the API anyway.
ALARM_STRIP_JQ='del(.id, .self, .creationTime, .lastUpdated, .count, .firstOccurrenceTime, .history, .source)'

# Records in chronological order. Streams through sort rather than slurping the
# file into jq, which matters at measurement volumes. Cumulocity returns UTC
# timestamps, which sort lexicographically; mixed offsets would not.
#
# The key is plain interpolation and NOT @tsv. @tsv escapes backslashes in the
# field it emits, so a record whose text contains escaped JSON - `\"a\": 1`,
# which real alarms do carry - comes back out with every backslash doubled and
# is no longer valid JSON. tojson never emits a literal tab or newline, so
# interpolating it into a tab separated line is safe without any escaping.
sort_by_time() {
    jq -r '"\(.time // "")\t\(tojson)"' "$1" | LC_ALL=C sort -k1,1 | cut -f2-
}

records_in() {
    grep -c '' < "$1" || true
}

# Device data belonging to one managed object, recreated against its new id.
import_device_data() {
    local inputDirectory="$1" oldId="$2" newId="$3" name="$4"
    local dataDirectory="${inputDirectory}/data/${oldId}"

    [[ -d "$dataDirectory" ]] || return 0

    import_measurements "$dataDirectory" "$newId" "$name"
    import_events "$dataDirectory" "$newId" "$name"
    import_alarms "$dataDirectory" "$newId" "$name"
}

# NOTE on stdin: these are the only calls in this extension that intentionally
# consume it. --device is the pipeline target on every create command, so
# piping the records in is how throughput is achieved and --nullInput must NOT
# be used. Everywhere else it still must be.
import_measurements() {
    local dataDirectory="$1" newId="$2" name="$3"
    local file="${dataDirectory}/measurements.jsonl" count

    [[ -f "$file" ]] || return 0
    count=$(records_in "$file")
    [[ "$count" -gt 0 ]] || return 0

    # Oldest first: c8y_LatestMeasurements on the managed object holds the last
    # value RECEIVED rather than the newest by timestamp, so an out of order
    # backfill would leave the device showing a stale reading as its latest.
    if sort_by_time "$file" | c8y measurements createBulk --device "$newId" \
        --batchSize "$MEASUREMENT_BATCH_SIZE" \
        --processingMode "$DATA_PROCESSING_MODE" \
        --workers "$DATA_WORKERS" --delay "$DATA_DELAY" \
        "${forceArgs[@]}" > /dev/null; then
        measurementsCreated=$((measurementsCreated + count))
        echo "Imported $count $(plural "$count" measurement measurements) for $name ($newId)" >&2
    else
        dataFailures=$((dataFailures + count))
        echo "Failed to import measurements for $name ($newId)" >&2
    fi
}

import_events() {
    local dataDirectory="$1" newId="$2" name="$3"
    local file="${dataDirectory}/events.jsonl"
    local record cleaned oldEventId newEventId binary hasBinary created=0

    [[ -f "$file" ]] || return 0

    # Oldest first, for the same reason as measurements and alarms.
    while IFS= read -r record; do
        [[ -n "$record" ]] || continue

        oldEventId=$(printf '%s' "$record" | jq -r '.id // empty')
        hasBinary=$(printf '%s' "$record" | jq -r 'has("c8y_IsBinary")')
        cleaned=$(printf '%s' "$record" | jq -c "$EVENT_STRIP_JQ")

        newEventId=$(printf '%s' "$cleaned" | jq -r 'empty' 2>/dev/null; \
            c8y events create --device "$newId" --data "$cleaned" \
                --processingMode "$DATA_PROCESSING_MODE" --select id --nullInput \
                "${forceArgs[@]}" | jq -r '.id')

        if [[ -z "$newEventId" || "$newEventId" == "null" ]]; then
            dataFailures=$((dataFailures + 1))
            echo "Failed to create event $oldEventId for $name ($newId)" >&2
            continue
        fi
        created=$((created + 1))
        eventsCreated=$((eventsCreated + 1))

        [[ "$hasBinary" == "true" ]] || continue

        binary="${dataDirectory}/binaries/${oldEventId}"
        if [[ ! -f "$binary" ]]; then
            # Not counted as a failure, deliberately. The export is what is
            # incomplete, so retrying the import cannot fix it - and a resume
            # that failed on this would redo the device and fail again forever.
            echo "Event $oldEventId claimed an attachment but none was exported" >&2
            continue
        fi

        # the attachment is addressed by the NEW event id
        if c8y events createBinary --id "$newEventId" --file "$binary" \
            --nullInput "${forceArgs[@]}" > /dev/null; then
            binariesCreated=$((binariesCreated + 1))
            echo "Attached $(basename "$binary") to event $newEventId of $name ($newId)" >&2
        else
            dataFailures=$((dataFailures + 1))
            echo "Failed to attach $(basename "$binary") to event $newEventId" >&2
        fi
    done < <(sort_by_time "$file")

    if [[ "$created" -gt 0 ]]; then
        echo "Imported $created $(plural "$created" event events) for $name ($newId)" >&2
    fi
}

import_alarms() {
    local dataDirectory="$1" newId="$2" name="$3"
    local file="${dataDirectory}/alarms.jsonl"
    local record cleaned created=0 failed=0

    [[ -f "$file" ]] || return 0

    # Oldest first, and it matters more here than for measurements: Cumulocity
    # de-duplicates on source and type while an alarm is ACTIVE or
    # ACKNOWLEDGED, so a still-open alarm created before the cleared history of
    # the same type would absorb it and only bump its count.
    #
    # No --processingMode: QUIESCENT is documented as applying to measurements
    # and events only, and alarm creation is always PERSISTENT regardless.
    while IFS= read -r record; do
        [[ -n "$record" ]] || continue

        cleaned=$(printf '%s' "$record" | jq -c "$ALARM_STRIP_JQ")

        if c8y alarms create --device "$newId" --data "$cleaned" --nullInput \
            "${forceArgs[@]}" > /dev/null; then
            created=$((created + 1))
            alarmsCreated=$((alarmsCreated + 1))
        else
            failed=$((failed + 1))
        fi
    done < <(sort_by_time "$file")

    if [[ "$created" -gt 0 ]]; then
        echo "Imported $created $(plural "$created" alarm alarms) for $name ($newId)" >&2
    fi
    if [[ "$failed" -gt 0 ]]; then
        dataFailures=$((dataFailures + failed))
        echo "Failed to import $failed $(plural "$failed" alarm alarms) for $name ($newId)" >&2
    fi
}

# Loads an existing mapping so data can be attached to a hierarchy migrated by
# an earlier run. Interpolated rather than @tsv: @tsv escapes backslashes, which
# once corrupted records on their way through a sort.
load_existing_mapping() {
    local flag="--dataOnly"
    [[ "$resume" != "true" ]] || flag="--resume"

    if [[ ! -f "$mappingFile" ]]; then
        echo "$flag needs an existing mapping file, and $mappingFile does not exist" >&2
        exit 1
    fi
    if ! jq -e 'type == "object"' "$mappingFile" > /dev/null 2>&1; then
        echo "Mapping file is not a JSON object: $mappingFile" >&2
        exit 1
    fi
    jq -r 'to_entries[] | "\(.key)\t\(.value)\t"' "$mappingFile" > "$idMap"
}

# The mapping records ids only, so names come from the export. Without this the
# progress lines would say "device 2" where a full import says "Line A".
backfill_names() {
    local inputDirectory="$1"
    local named oldId newId name

    named="$idMap.named"
    : > "$named"
    while IFS=$'\t' read -r oldId newId name; do
        if [[ -z "$name" && -f "$inputDirectory/exported_device_$oldId.json" ]]; then
            name=$(read_name "$inputDirectory/exported_device_$oldId.json")
        fi
        printf '%s\t%s\t%s\n' "$oldId" "$newId" "$name" >> "$named"
    done < "$idMap"
    mv "$named" "$idMap"
}

# A resume trusts the mapping for what already exists, so an object deleted in
# the meantime would be skipped and never recreated. The run marker is what
# makes checking cheap: one indexed --fragmentType query returns everything the
# run still has, and anything in the mapping outside that set is stale.
#
# With no marker - an import run with no --runId - there is nothing to check
# against and the mapping is taken at its word.
prune_deleted_from_mapping() {
    [[ -n "$markerFragment" ]] || return 0

    local live kept oldId newId name dropped=0

    # --includeAll because c8y's default page size is 5. Without it only the
    # first handful of live objects would be seen, every other mapping entry
    # would look deleted, and a resume would recreate them - duplicating most of
    # the hierarchy instead of repairing it.
    live=$(c8y inventory find --fragmentType "$markerFragment" --select id \
        --includeAll --nullInput | jq -r '.id')

    kept="$idMap.kept"
    : > "$kept"
    while IFS=$'\t' read -r oldId newId name; do
        if printf '%s\n' "$live" | grep -qx "$newId"; then
            printf '%s\t%s\t%s\n' "$oldId" "$newId" "$name" >> "$kept"
        else
            dropped=$((dropped + 1))
            echo "$name ($newId) is gone from the target, it will be created again" >&2
        fi
    done < "$idMap"
    mv "$kept" "$idMap"

    if [[ "$dropped" -gt 0 ]]; then
        write_mapping
    fi
}

# Data for devices that already exist in the target. This is what lets a large
# migration move data one device at a time instead of staging all of it first.
import_data_only() {
    local inputDirectory="$1"
    local dataDirectory oldId newId name

    for dataDirectory in "$inputDirectory"/data/*; do
        [[ -d "$dataDirectory" ]] || continue

        oldId=$(basename "$dataDirectory")
        newId=$(lookup_new_id "$oldId")
        if [[ -z "$newId" ]]; then
            echo "Skipping data for ($oldId), it is not in the mapping" >&2
            continue
        fi

        name=$(lookup_name "$oldId")
        [[ -n "$name" ]] || name="device $oldId"

        import_device_data "$inputDirectory" "$oldId" "$newId" "$name"
        dataDevices=$((dataDevices + 1))
    done
}

import_devices() {
    local inputDirectory="$1"
    local workDirectory="$2"
    local deviceFile oldId newId name

    for deviceFile in "$inputDirectory"/exported_device_*.json; do
        [[ -e "$deviceFile" ]] || continue

        oldId=$(basename "$deviceFile" .json)
        oldId=${oldId#exported_device_}
        name=$(read_name "$deviceFile")

        # On a resume the mapping is the record of what already exists. Anything
        # listed there is left alone, which is what stops a resume from creating
        # a second copy of every object the first attempt got through.
        if [[ "$resume" == "true" ]]; then
            newId=$(lookup_new_id "$oldId")
            if [[ -n "$newId" ]]; then
                echo "Already imported $name ($oldId -> $newId)" >&2
                continue
            fi
        fi

        jq --arg marker "$markerFragment" \
            "$STRIP_PROPERTIES | if \$marker == \"\" then . else . + {(\$marker): {}} end" \
            "$deviceFile" > "$workDirectory/managed_object.json"

        newId=$(c8y inventory create --template "$workDirectory/managed_object.json" --select id --nullInput "${forceArgs[@]}" | jq -r '.id')

        if [[ -z "$newId" || "$newId" == "null" ]]; then
            echo "Failed to create a managed object for $name ($oldId)" >&2
            exit 1
        fi

        printf '%s\t%s\t%s\n' "$oldId" "$newId" "$name" >> "$idMap"
        write_mapping
        echo "Imported $name ($oldId -> $newId)" >&2

        import_identities "$inputDirectory" "$oldId" "$newId" "$name"
        import_device_data "$inputDirectory" "$oldId" "$newId" "$name"
    done
}

# Recreate the external identities of one managed object against its new id.
# An external id is unique per type within a tenant, so a target tenant that
# already knows it will reject the request. That is worth reporting loudly, but
# not worth aborting a bulk migration over, so it is counted and carried on.
import_identities() {
    local inputDirectory="$1" oldId="$2" newId="$3" name="$4"
    local identityFile="${inputDirectory}/${oldId}_identities.json"
    local externalType externalId

    [[ -f "$identityFile" ]] || return 0

    while IFS=$'\t' read -r externalType externalId; do
        [[ -n "$externalType" && -n "$externalId" ]] || continue

        if c8y identity create --device "$newId" --type "$externalType" \
            --name "$externalId" --nullInput "${forceArgs[@]}" > /dev/null; then
            identitiesCreated=$((identitiesCreated + 1))
            echo "Added external identity $externalType:$externalId to $name ($newId)" >&2
        else
            identitiesFailed=$((identitiesFailed + 1))
            echo "Could not add external identity $externalType:$externalId to $name ($newId), it may already exist in the target tenant" >&2
        fi
    done < <(jq -r '.[] | [.type, .externalId] | @tsv' "$identityFile")
}

link_children() {
    local inputDirectory="$1"
    local childFile baseName oldParentId childType newParentId parentName
    local oldChildId newChildId childName existingChildren

    for childFile in "$inputDirectory"/*_child_*.json; do
        [[ -e "$childFile" ]] || continue

        baseName=$(basename "$childFile" .json)
        oldParentId=${baseName%%_child_*}
        childType=${baseName##*_child_}

        newParentId=$(lookup_new_id "$oldParentId")
        if [[ -z "$newParentId" ]]; then
            echo "Skipping children of ($oldParentId), the parent was not part of the import" >&2
            continue
        fi
        parentName=$(lookup_name "$oldParentId")

        existingChildren=""
        if [[ "$resume" == "true" ]]; then
            # --nullInput for the same reason as the assign below
            existingChildren=$(c8y inventory children list --childType "$childType" \
                --id "$newParentId" --select id --nullInput | jq -r '.id')
        fi

        while IFS= read -r oldChildId; do
            [[ -n "$oldChildId" ]] || continue

            newChildId=$(lookup_new_id "$oldChildId")
            if [[ -z "$newChildId" ]]; then
                echo "Skipping child ($oldChildId) of $parentName ($newParentId), the child was not part of the import" >&2
                continue
            fi
            childName=$(lookup_name "$oldChildId")

            # On a resume the relationship may already exist. Asking the target
            # what it has costs one read per parent and type, and it avoids
            # depending on how Cumulocity answers a duplicate assignment -
            # which is not something to guess at.
            if [[ "$resume" == "true" ]]; then
                if printf '%s\n' "$existingChildren" | grep -qx "$newChildId"; then
                    echo "Already assigned $childName ($newChildId) as $childType child of $parentName ($newParentId)" >&2
                    continue
                fi
            fi

            # --nullInput because --child accepts pipeline input, so c8y would
            # otherwise drain the child ID list feeding this loop and only the
            # first child of each parent would ever be assigned
            c8y inventory children assign --id "$newParentId" --childType "$childType" \
                --child "$newChildId" --nullInput "${forceArgs[@]}" > /dev/null
            echo "Assigned $childName ($newChildId) as $childType child of $parentName ($newParentId)" >&2
        done < <(jq -r '.[]' "$childFile")
    done
}

# A staging directory with a name that says where it came from.
#
# `mktemp -d` with no template ignores TMPDIR on macOS and always uses the
# system temp directory, which makes a leaked directory both untraceable and
# untestable. An explicit template fixes the location and gives the directory a
# recognisable prefix.
staging_directory() {
    local base="${TMPDIR:-/tmp}"
    mktemp -d "${base%/}/c8y-devicemigration.XXXXXXXX"
}

# Selects the tenant for every c8y call this command makes.
#
# C8Y_SESSION resolves exactly as the --session flag does: a path, a full file
# name including its extension, or a glob matched against the session home. A
# bare session name without the extension does NOT resolve, whatever the
# upstream docs say.
#
# The ambient C8Y_* variables are cleared as well. Without --session they are
# bound and take precedence over the session file, so a stray C8Y_HOST left in
# the environment would silently redirect every request to the wrong tenant.
# Choosing a session explicitly means the file decides, and nothing else.
use_session() {
    local session="$1"

    [[ -n "$session" ]] || return 0

    export C8Y_SESSION="$session"
    unset C8Y_HOST C8Y_BASEURL C8Y_URL C8Y_TENANT C8Y_USER C8Y_USERNAME \
        C8Y_PASSWORD C8Y_TOKEN
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
run_import() {
    eval "$(docopt "$@")"

    use_session "${__session:-}"
    resolve_marker_fragment "${__runId:-}" "${__noFlag:-}"

    dataOnly="$__dataOnly"
    resume="$__resume"

    mappingFile="${__mapping:-id_mapping.json}"
    local workDirectory inputDirectory

    if [[ "$__force" == "true" ]]; then
        forceArgs=(--force)
    fi

    workDirectory=$(staging_directory)
    # shellcheck disable=2064
    trap "rm -rf '$workDirectory'" EXIT

    idMap="$workDirectory/id_map.tsv"
    : > "$idMap"
    # An empty mapping up front means an immediate failure still leaves a file.
    # Not on a resume: there the mapping already exists and is the input, so
    # writing over it would destroy the record about to be read.
    if [[ "$resume" != "true" ]]; then
        write_mapping
    fi

    if [[ -n "$__input_compressed" ]]; then
        inputDirectory="$workDirectory/extracted"
        mkdir -p "$inputDirectory"
        tar -xzf "$__input_compressed" -C "$inputDirectory"
    else
        inputDirectory="$__input_directory"
    fi

    if [[ ! -d "$inputDirectory" ]]; then
        echo "Input directory does not exist: $inputDirectory" >&2
        exit 1
    fi

    # Announced by whatever actually applies it, so the id is in the log of the
    # run that used it. Not under --dataOnly: that creates no objects, so there
    # is nothing to mark and saying otherwise would be a lie.
    if [[ -n "$markerFragment" && "$dataOnly" != "true" ]]; then
        echo "Run id ${markerRunId}, marking created objects with $markerFragment" >&2
    fi

    if [[ "$dataOnly" == "true" ]]; then
        # No objects and no relationships: those already exist from an earlier
        # run, and the mapping is how this data finds them.
        load_existing_mapping
        backfill_names "$inputDirectory"
        import_data_only "$inputDirectory"
    else
        if [[ "$resume" == "true" ]]; then
            load_existing_mapping
            backfill_names "$inputDirectory"
            prune_deleted_from_mapping
        fi
        import_devices "$inputDirectory" "$workDirectory"
        link_children "$inputDirectory"
    fi

    write_mapping

    if [[ "$dataOnly" != "true" ]]; then
        echo "Imported $(grep -c '' "$idMap") devices and $identitiesCreated external identities, ID mapping written to $mappingFile" >&2
    fi
    # A single device's totals can only restate the per-device lines above
    if [[ "$dataOnly" != "true" || "$dataDevices" -gt 1 ]]; then
        if [[ "$measurementsCreated" -gt 0 || "$eventsCreated" -gt 0 || "$alarmsCreated" -gt 0 ]]; then
            local dataLine
            dataLine="Imported $measurementsCreated $(plural "$measurementsCreated" measurement measurements)"
            dataLine+=", $eventsCreated $(plural "$eventsCreated" event events)"
            dataLine+=" and $alarmsCreated $(plural "$alarmsCreated" alarm alarms)"
            if [[ "$binariesCreated" -gt 0 ]]; then
                dataLine+=", including $binariesCreated $(plural "$binariesCreated" attachment attachments)"
            fi
            echo "$dataLine" >&2
        fi
    fi

    if [[ "$identitiesFailed" -gt 0 ]]; then
        echo "$identitiesFailed external identities could not be created" >&2
    fi

    # Last, and it exits non-zero: everything above already said what did land,
    # and a caller that read a zero exit code here would go on to treat a
    # part-delivered device as finished.
    if [[ "$dataFailures" -gt 0 ]]; then
        echo "$dataFailures $(plural "$dataFailures" record records) could not be imported, so this import is incomplete" >&2
        exit 1
    fi
}

run_import "$@"
