# docopt parser above, complete command for generating this parser is `docopt.sh revert`

# Objects deleted by this run, and those still present when it finished
deleted=0
failed=0

# Tab separated plan: <oldId> <newId> <state> <name>
plan=""

# Reads the mapping and establishes, for every object import created, whether it
# is still present in the currently active session. Nothing is deleted here.
build_plan() {
    local mappingFile="$1" workDirectory="$2"
    local oldId newId owner name

    while IFS=$'\t' read -r oldId newId; do
        [[ -n "$oldId" && -n "$newId" ]] || continue

        # A 404 here is how an already absent object is detected, so the
        # non-zero exit code IS the signal: do not add --silentExit to this
        # call, or every object would look present. stdout and stderr are
        # discarded because the plan printed below is what the caller reads.
        if c8y inventory get --id "$newId" --select id,name,owner \
            --outputFileRaw "$workDirectory/object.json" --nullInput \
            > /dev/null 2>&1; then
            name=$(jq -rj '.name // empty' "$workDirectory/object.json" | tr '\t\n' '  ')
            if [[ -z "${name// /}" ]]; then
                name="<unnamed>"
            fi
            # The owner decides whether this object's delete may ask for its
            # device user to go too.
            #
            # "-" when there is none, never an empty field: tab counts as IFS
            # whitespace, so `IFS=$'\t' read` collapses a run of tabs into one
            # and an empty column in the middle shifts every column after it -
            # which showed up as every object in the plan losing its name.
            owner=$(jq -rj '.owner // empty' "$workDirectory/object.json" | tr '\t\n' '  ')
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$oldId" "$newId" "present" "${owner:--}" "$name" >> "$plan"
        else
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$oldId" "$newId" "missing" "-" "<not found>" >> "$plan"
        fi
    done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' "$mappingFile")
}

# Everything that would be removed, printed before anything is touched.
# The other way to build a plan: ask the tenant which objects carry the run
# marker. --fragmentType is a first-class inventory filter, so this is one
# indexed query and not a scan. There is no source id to report, because the
# marker body is empty by design - it says which run created an object, not
# which object it came from.
build_plan_from_marker() {
    local runId="$1"
    local fragment="c8y_DeviceMigration_$runId"
    local found line id name

    # --includeAll because c8y's default page size is 5. Without it a run of more
    # than five objects would be planned only in part, and the revert would
    # report success having deleted a fraction of it.
    found=$(c8y inventory find --fragmentType "$fragment" --select id,name,owner \
        --includeAll --nullInput)

    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        id=$(printf '%s' "$line" | jq -rj '.id')
        name=$(printf '%s' "$line" | jq -rj '.name // empty' | tr '\t\n' '  ')
        if [[ -z "${name// /}" ]]; then
            name="<unnamed>"
        fi
        owner=$(printf '%s' "$line" | jq -rj '.owner // empty' | tr '\t\n' '  ')
        # Found by querying the tenant, so it is present by construction. "-"
        # for an absent owner, for the IFS reason in build_plan.
        printf '%s\t%s\t%s\t%s\t%s\n' "-" "$id" "present" "${owner:--}" "$name" >> "$plan"
    done <<< "$found"
}

print_plan() {
    local oldId newId state owner name presentCount missingCount

    presentCount=$(awk -F'\t' '$3 == "present"' "$plan" | grep -c '' | tr -d ' ')
    missingCount=$(awk -F'\t' '$3 == "missing"' "$plan" | grep -c '' | tr -d ' ')

    echo "The following managed objects will be deleted from the active session:" >&2
    while IFS=$'\t' read -r oldId newId state owner name; do
        if [[ "$state" == "present" ]]; then
            if [[ "$oldId" == "-" ]]; then
                echo "  delete $name ($newId)" >&2
            else
                echo "  delete $name ($newId, imported from $oldId)" >&2
            fi
        fi
    done < "$plan"

    if [[ "$missingCount" -gt 0 ]]; then
        echo "" >&2
        echo "Already absent, nothing to do for these:" >&2
        while IFS=$'\t' read -r oldId newId state owner name; do
            if [[ "$state" == "missing" ]]; then
                echo "  skip   $newId (imported from $oldId)" >&2
            fi
        done < "$plan"
    fi

    echo "" >&2
    echo "$presentCount managed objects will be deleted, $missingCount are already absent." >&2
    echo "Their external identities and parent/child relationships go with them." >&2
    echo "Deleting a group also propagates to its subgroups, which may remove" >&2
    echo "objects that this import did not create." >&2

    printf '%s' "$presentCount"
}

# Hands every planned id to a single c8y invocation, so confirmation is c8y's
# own dialog rather than a home grown one. One invocation and not one per object
# because its "Yes to All" answer is held in process: separate calls would ask
# again for every object. --force is passed straight through, which is what
# suppresses the dialog.
delete_planned() {
    local force="$1" errorLog="$2"
    local oldId newId state owner name
    local deleteArgs=()

    # Partitioned by owner, because withDeviceUser is not a flag to set blindly.
    # An object owned by a device user has one to remove; a *device* owned by
    # anything else answers withDeviceUser=true with a 409 and stays where it is.
    # These commands never provision credentials, so ordinarily every object
    # lands in the second group and this is one invocation exactly as before -
    # the split only appears when undoing a migration made by the Go
    # implementation, which does provision them.
    local deviceUserArgs=()
    while IFS=$'\t' read -r oldId newId state owner name; do
        [[ "$state" == "present" ]] || continue
        if [[ "$owner" == device_* ]]; then
            deviceUserArgs+=(--id "$newId")
        else
            deleteArgs+=(--id "$newId")
        fi
    done < "$plan"

    : > "$errorLog"

    # A 404 is expected rather than exceptional: Cumulocity propagates a group
    # deletion to its subgroups, so an object can already be gone by the time its
    # own delete request is sent. --silentStatusCodes stops c8y reporting those,
    # and --silentExit keeps them out of its exit code.
    #
    # --withDeviceUser goes on the device-user group only. It is what stops an
    # undo leaving a credential that still authenticates against the target,
    # which would look like success while the device could still connect.
    if [[ ${#deviceUserArgs[@]} -gt 0 ]]; then
        run_delete "$force" "$errorLog" --withDeviceUser "${deviceUserArgs[@]}"
    fi
    if [[ ${#deleteArgs[@]} -gt 0 ]]; then
        run_delete "$force" "$errorLog" "${deleteArgs[@]}"
    fi
}

# One c8y invocation, so confirmation is c8y's own dialog rather than a home
# grown one and its "Yes to All" is held for the whole batch.
#
# Appends to the error log rather than truncating it: with credentials in play
# there can be two invocations, and the second must not erase what the first
# reported.
run_delete() {
    local force="$1" errorLog="$2"
    shift 2

    local deleteCommand=(
        c8y inventory delete "$@" --nullInput
        --silentStatusCodes 404 --silentExit
    )

    if [[ "$force" == "true" ]]; then
        # Nothing will be asked, so stderr can be captured and shown later only
        # if an object survived.
        "${deleteCommand[@]}" --force > /dev/null 2>> "$errorLog" || true
    else
        # c8y renders its confirmation dialog on STDERR. Redirecting it would
        # hide the prompt while c8y waited on the terminal for an answer, which
        # looks exactly like a hung process. Leave stderr alone here and rely on
        # --silentStatusCodes to keep the expected 404s quiet.
        "${deleteCommand[@]}" > /dev/null || true
    fi
}

# What actually happened, established by looking the objects up again rather
# than by trusting exit codes. This reports the truth whether an object was
# deleted on request, removed by propagation from its parent, or left alone
# because the confirmation was declined.
report_outcome() {
    local outcome="$1"
    local oldId newId state owner name

    while IFS=$'\t' read -r oldId newId state owner name; do
        [[ "$state" == "present" ]] || continue

        # as in build_plan, the non-zero exit on a missing object is the signal
        if c8y inventory get --id "$newId" --select id --nullInput > /dev/null 2>&1; then
            failed=$((failed + 1))
            printf 'present\t%s\t%s\n' "$newId" "$name" >> "$outcome"
        else
            deleted=$((deleted + 1))
            printf 'deleted\t%s\t%s\n' "$newId" "$name" >> "$outcome"
        fi
    done < "$plan"

    # A declined confirmation leaves everything in place. Listing every object
    # as still present would bury that behind noise, so say it once instead.
    if [[ "$deleted" -eq 0 ]]; then
        echo "Nothing was deleted" >&2
        return 0
    fi

    while IFS=$'\t' read -r state newId name; do
        if [[ "$state" == "deleted" ]]; then
            echo "Deleted $name ($newId)" >&2
        else
            echo "Still present: $name ($newId)" >&2
        fi
    done < "$outcome"
}

# A staging directory with a name that says where it came from.
#
# `mktemp -d` with no template ignores TMPDIR on macOS and always uses the
# system temp directory, which makes a leaked directory both untraceable and
# untestable. An explicit template fixes the location and gives the directory a
# recognisable prefix.
staging_directory() {
    local base="${TMPDIR:-/tmp}"
    mktemp -d "${base%/}/c8y-devicemigration.XXXXXXXX"
}

# Selects the tenant for every c8y call this command makes.
#
# C8Y_SESSION resolves exactly as the --session flag does: a path, a full file
# name including its extension, or a glob matched against the session home. A
# bare session name without the extension does NOT resolve, whatever the
# upstream docs say.
#
# The ambient C8Y_* variables are cleared as well. Without --session they are
# bound and take precedence over the session file, so a stray C8Y_HOST left in
# the environment would silently redirect every request to the wrong tenant.
# Choosing a session explicitly means the file decides, and nothing else.
use_session() {
    local session="$1"

    [[ -n "$session" ]] || return 0

    export C8Y_SESSION="$session"
    unset C8Y_HOST C8Y_BASEURL C8Y_URL C8Y_TENANT C8Y_USER C8Y_USERNAME \
        C8Y_PASSWORD C8Y_TOKEN
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
run_revert() {
    eval "$(docopt "$@")"

    use_session "${__session:-}"

    local workDirectory presentCount

    if [[ -n "$__runId" ]]; then
        case "$__runId" in
            *[!A-Za-z0-9_]*)
                echo "Invalid --runId '$__runId': fragment names may only contain letters, digits and underscores" >&2
                exit 1
                ;;
        esac
    else
        if [[ ! -f "$__mapping" ]]; then
            echo "Mapping file does not exist: $__mapping" >&2
            exit 1
        fi
        if ! jq -e 'type == "object"' "$__mapping" > /dev/null 2>&1; then
            echo "Mapping file is not a JSON object: $__mapping" >&2
            exit 1
        fi
    fi

    workDirectory=$(staging_directory)
    # shellcheck disable=2064
    trap "rm -rf '$workDirectory'" EXIT

    plan="$workDirectory/plan.tsv"
    : > "$plan"

    if [[ -n "$__runId" ]]; then
        build_plan_from_marker "$__runId"
    else
        build_plan "$__mapping" "$workDirectory"
    fi

    if [[ ! -s "$plan" ]]; then
        if [[ -n "$__runId" ]]; then
            echo "No managed object carries c8y_DeviceMigration_$__runId, nothing to revert" >&2
        else
            echo "The mapping file lists no objects, nothing to revert" >&2
        fi
        return 0
    fi

    presentCount=$(print_plan)

    if [[ "$presentCount" -eq 0 ]]; then
        echo "Nothing to delete" >&2
        return 0
    fi

    delete_planned "$__force" "$workDirectory/delete-errors.log"
    report_outcome "$workDirectory/outcome.tsv"

    # Anything c8y complained about only matters if an object survived. When
    # every planned object is gone, the complaints were about objects a parent
    # had already taken with it, which is not something to report as a problem.
    if [[ "$failed" -gt 0 && -s "$workDirectory/delete-errors.log" ]]; then
        cat "$workDirectory/delete-errors.log" >&2
    fi

    echo "Deleted $deleted of $presentCount managed objects, $failed are still present" >&2
    if [[ "$failed" -gt 0 ]]; then
        echo "The revert is incomplete, rerun it to retry the remaining objects" >&2
        exit 1
    fi
}

run_revert "$@"
