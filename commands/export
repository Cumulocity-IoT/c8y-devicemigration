# docopt parser above, complete command for generating this parser is `docopt.sh export`


# IDs already written to the export, used to break cycles in the hierarchy and
# to avoid exporting a device twice when several parents reference it
exported_ids=" "

# Child relationship types to follow, set from --childTypes
childTypes=""

# Totals for the closing summary
exportedCount=0
identityCount=0
measurementCount=0
eventCount=0
alarmCount=0
binaryCount=0

# Device data types to export, set from --dataTypes. Empty means none.
dataTypes=""

# Summary fragment for the device currently being exported. A global rather
# than a return value on stdout: a command substitution would run the data
# functions in a subshell and their updates to the totals would be lost.
dataSummary=""

# --dateFrom / --dateTo, passed through to the list commands
dateArgs=()

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
resolve_data_types() {
    local requested dataType

    requested="${__dataTypes:-}"
    if [[ -z "${requested// /}" ]]; then
        dataTypes=""
        return 0
    fi

    dataTypes=$(printf '%s' "$requested" | tr ',' ' ')

    # shellcheck disable=2086
    for dataType in $dataTypes; do
        case "$dataType" in
            measurements|events|alarms) ;;
            operations)
                echo "Operations are not migrated: they cannot be created with a status, so every" >&2
                echo "recreated operation would be PENDING and the target device would execute it" >&2
                exit 1
                ;;
            *)
                echo "Unsupported data type '$dataType', expected measurements, events or alarms" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "${dataTypes// /}" ]]; then
        echo "No data types given, expected a comma separated list of measurements, events or alarms" >&2
        exit 1
    fi
}

# shellcheck disable=SC2154
resolve_date_args() {
    if [[ -n "$__dateFrom" ]]; then
        dateArgs+=(--dateFrom "$__dateFrom")
    fi
    if [[ -n "$__dateTo" ]]; then
        dateArgs+=(--dateTo "$__dateTo")
    fi
}

# Is one data type requested?
wants_data() {
    [[ " $dataTypes " == *" $1 "* ]]
}

# Name of a managed object as it appears in the export, for logging only
read_name() {
    local name
    # -j so no trailing newline is turned into a trailing space by tr
    name=$(jq -rj '.name // empty' "$1" | tr '\t\n' '  ')
    if [[ -z "${name// /}" ]]; then
        name="<unnamed>"
    fi
    printf '%s' "$name"
}

report_totals() {
    local line

    line="Exported $exportedCount $(plural "$exportedCount" "managed object" "managed objects")"
    line+=" and $identityCount $(plural "$identityCount" "external identity" "external identities")"

    if [[ -n "${dataTypes// /}" ]]; then
        line+=", with $measurementCount $(plural "$measurementCount" measurement measurements)"
        line+=", $eventCount $(plural "$eventCount" event events)"
        line+=" and $alarmCount $(plural "$alarmCount" alarm alarms)"
        if [[ "$binaryCount" -gt 0 ]]; then
            line+=" including $binaryCount $(plural "$binaryCount" attachment attachments)"
        fi
    fi

    echo "$line to $1" >&2
}

plural() {
    if [[ "$1" -eq 1 ]]; then
        printf '%s' "$2"
    else
        printf '%s' "$3"
    fi
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
resolve_child_types() {
    local requested childType

    # --no-children exports the root on its own, so nothing is traversed. An
    # empty childTypes makes the loop over child types below iterate zero times.
    if [[ "$__no_children" == "true" ]]; then
        childTypes=""
        return 0
    fi

    requested="${__childTypes:-asset,device}"
    childTypes=$(printf '%s' "$requested" | tr ',' ' ')

    # shellcheck disable=2086
    for childType in $childTypes; do
        case "$childType" in
            asset|device|addition) ;;
            *)
                echo "Unsupported child type '$childType', expected asset, device or addition" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "${childTypes// /}" ]]; then
        echo "No child types given, expected a comma separated list of asset, device or addition" >&2
        exit 1
    fi
}

# Device data for one device, written as NDJSON under data/<id>/. Records are
# written verbatim: import decides what to strip, exactly as it does for the
# managed objects themselves. Keeping the record ids is also what makes event
# attachments correlatable.
#
# Returns nothing; appends to the per-type totals and echoes a summary fragment.
export_device_data() {
    local deviceId="$1" outputDirectory="$2"
    local dataDirectory="${outputDirectory}/data/${deviceId}"
    local count

    dataSummary=""

    if [[ -z "${dataTypes// /}" ]]; then
        return 0
    fi

    if wants_data measurements; then
        mkdir -p "$dataDirectory"
        c8y measurements list --device "$deviceId" "${dateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/measurements.jsonl"
        count=$(grep -c '' < "${dataDirectory}/measurements.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/measurements.jsonl"
        else
            measurementCount=$((measurementCount + count))
            dataSummary+=", $count $(plural "$count" measurement measurements)"
        fi
    fi

    if wants_data events; then
        mkdir -p "$dataDirectory"
        c8y events list --device "$deviceId" "${dateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/events.jsonl"
        count=$(grep -c '' < "${dataDirectory}/events.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/events.jsonl"
        else
            eventCount=$((eventCount + count))
            dataSummary+=", $count $(plural "$count" event events)"
            export_event_binaries "$dataDirectory"
        fi
    fi

    if wants_data alarms; then
        mkdir -p "$dataDirectory"
        c8y alarms list --device "$deviceId" "${dateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/alarms.jsonl"
        count=$(grep -c '' < "${dataDirectory}/alarms.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/alarms.jsonl"
        else
            alarmCount=$((alarmCount + count))
            dataSummary+=", $count $(plural "$count" alarm alarms)"
        fi
    fi

    # leave no empty directory behind for a device with no data at all
    rmdir "$dataDirectory" 2>/dev/null || true
}

# Downloads the attachment of every event that has one. Events carrying a
# binary are marked with a c8y_IsBinary fragment, so only those cost a request.
export_event_binaries() {
    local dataDirectory="$1"
    local eventId count=0

    while IFS= read -r eventId; do
        [[ -n "$eventId" ]] || continue
        mkdir -p "${dataDirectory}/binaries"
        c8y events downloadBinary --id "$eventId" \
            --outputFileRaw "${dataDirectory}/binaries/${eventId}" --nullInput > /dev/null
        count=$((count + 1))
    done < <(jq -r 'select(has("c8y_IsBinary")) | .id' "${dataDirectory}/events.jsonl")

    if [[ "$count" -gt 0 ]]; then
        binaryCount=$((binaryCount + count))
        dataSummary+=", $count $(plural "$count" attachment attachments)"
    fi
}

export_device_recursive() {
    local deviceId="$1"
    local outputDirectory="$2"

    if [[ "$exported_ids" == *" $deviceId "* ]]; then
        return 0
    fi
    exported_ids+="$deviceId "

    # Export the current device. Its stdout is discarded: what the caller wants
    # to read is the progress line below, not the raw managed object.
    c8y inventory get --id "$deviceId" \
        --outputFileRaw "${outputDirectory}/exported_device_$deviceId.json" \
        --nullInput > /dev/null

    local name
    name=$(read_name "${outputDirectory}/exported_device_$deviceId.json")

    # External identities bound to the device. Written as a JSON array so the
    # file matches its extension, and only when the device actually has any.
    local identities identityFile deviceIdentities=0
    identities=$(c8y identity list --device "$deviceId" --select externalId,type --nullInput)
    if [[ -n "$identities" ]]; then
        identityFile="${outputDirectory}/${deviceId}_identities.json"
        printf '%s\n' "$identities" | jq -s 'map({type, externalId})' > "$identityFile"
        deviceIdentities=$(jq 'length' "$identityFile")
        identityCount=$((identityCount + deviceIdentities))
    fi

    # Children are gathered for every requested type before descending, so the
    # progress line for this device is complete and the output reads top down
    # rather than depth first.
    local childType children indexFile count summary="" pending=""
    # shellcheck disable=2086
    for childType in $childTypes; do
        # --nullInput so c8y never consumes the child ID list driving the loop
        # below, which would cut the traversal short after the first child
        children=$(c8y inventory children list --childType "$childType" --id "$deviceId" --select id --nullInput)

        if [[ -z "$children" ]]; then
            continue
        fi

        # Save child IDs to separate file per child type, as a JSON array so the
        # file matches its extension and a rerun replaces it instead of appending
        indexFile="${outputDirectory}/${deviceId}_child_${childType}.json"
        printf '%s\n' "$children" | jq -s 'map(.id)' > "$indexFile"

        count=$(jq 'length' "$indexFile")
        summary+=", $count $childType $(plural "$count" child children)"
        pending+="$(jq -r '.[]' "$indexFile")"$'\n'
    done

    if [[ "$deviceIdentities" -gt 0 ]]; then
        summary+=", $deviceIdentities $(plural "$deviceIdentities" identity identities)"
    fi

    export_device_data "$deviceId" "$outputDirectory"
    summary+="$dataSummary"

    exportedCount=$((exportedCount + 1))
    echo "Exported $name ($deviceId)$summary" >&2

    local childId
    while IFS= read -r childId; do
        if [[ -n "$childId" ]]; then
            export_device_recursive "$childId" "$outputDirectory" < /dev/null
        fi
    done <<< "$pending"
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
run_export() {
    eval "$(docopt "$@")"

    resolve_child_types
    resolve_data_types
    resolve_date_args

    if [[ -n "$__output_directory" ]]; then
        mkdir -p "$__output_directory"
        export_device_recursive "$__rootId" "$__output_directory"
        report_totals "$__output_directory"
        return 0
    fi

    # --output-compressed: collect the export in a staging directory, then archive it
    local stagingDirectory
    stagingDirectory=$(mktemp -d)
    # shellcheck disable=2064
    trap "rm -rf '$stagingDirectory'" EXIT

    export_device_recursive "$__rootId" "$stagingDirectory"
    tar -czf "$__output_compressed" -C "$stagingDirectory" .
    report_totals "$__output_compressed"
}

run_export "$@"
