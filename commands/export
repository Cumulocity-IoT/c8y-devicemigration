# docopt parser above, complete command for generating this parser is `docopt.sh export`


# IDs already written to the export, used to break cycles in the hierarchy and
# to avoid exporting a device twice when several parents reference it
exported_ids=" "

# Child relationship types to follow, set from --childTypes
childTypes=""

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
resolve_child_types() {
    local requested childType

    # --no-children exports the root on its own, so nothing is traversed. An
    # empty childTypes makes the loop over child types below iterate zero times.
    if [[ "$__no_children" == "true" ]]; then
        childTypes=""
        return 0
    fi

    requested="${__childTypes:-asset,device}"
    childTypes=$(printf '%s' "$requested" | tr ',' ' ')

    # shellcheck disable=2086
    for childType in $childTypes; do
        case "$childType" in
            asset|device|addition) ;;
            *)
                echo "Unsupported child type '$childType', expected asset, device or addition" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "${childTypes// /}" ]]; then
        echo "No child types given, expected a comma separated list of asset, device or addition" >&2
        exit 1
    fi
}

export_device_recursive() {
    local deviceId="$1"
    local outputDirectory="$2"

    if [[ "$exported_ids" == *" $deviceId "* ]]; then
        return 0
    fi
    exported_ids+="$deviceId "

    # Export the current device
    c8y inventory get --id "$deviceId" --outputFileRaw "${outputDirectory}/exported_device_$deviceId.json" --nullInput

    # Get children of all types and process them recursively
    local childType children childId
    # shellcheck disable=2086
    for childType in $childTypes; do
        # --nullInput so c8y never consumes the child ID list driving the loop
        # below, which would cut the traversal short after the first child
        children=$(c8y inventory children list --childType "$childType" --id "$deviceId" --select id --nullInput)

        if [[ -z "$children" ]]; then
            continue
        fi

        # Save child IDs to separate file per child type, as a JSON array so the
        # file matches its extension and a rerun replaces it instead of appending
        printf '%s\n' "$children" | jq -s 'map(.id)' > "${outputDirectory}/${deviceId}_child_${childType}.json"

        # Process each child recursively
        while IFS= read -r childId; do
            if [[ -n "$childId" ]]; then
                export_device_recursive "$childId" "$outputDirectory" < /dev/null
            fi
        done < <(printf '%s\n' "$children" | jq -r '.id')
    done
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
run_export() {
    eval "$(docopt "$@")"

    resolve_child_types

    if [[ -n "$__output_directory" ]]; then
        mkdir -p "$__output_directory"
        export_device_recursive "$__rootId" "$__output_directory"
        return 0
    fi

    # --output-compressed: collect the export in a staging directory, then archive it
    local stagingDirectory
    stagingDirectory=$(mktemp -d)
    # shellcheck disable=2064
    trap "rm -rf '$stagingDirectory'" EXIT

    export_device_recursive "$__rootId" "$stagingDirectory"
    tar -czf "$__output_compressed" -C "$stagingDirectory" .
}

run_export "$@"
