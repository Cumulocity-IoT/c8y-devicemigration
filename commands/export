# IDs already written to the export, used to break cycles in the hierarchy and
# to avoid exporting a device twice when several parents reference it
exported_ids=" "

# Child relationship types to follow, set from --childTypes
childTypes=""

# Totals for the closing summary
exportedCount=0
identityCount=0
measurementCount=0
eventCount=0
alarmCount=0
binaryCount=0

# Device data types to export, set from --dataTypes. Empty means none.
dataTypes=""

# Summary fragment for the device currently being exported. A global rather
# than a return value on stdout: a command substitution would run the data
# functions in a subshell and their updates to the totals would be lost.
dataSummary=""

# --dateFrom / --dateTo, passed through to the list commands. Split by type:
# measurements default to a window because an unbounded measurement export is
# the one that runs away, while events and alarms default to the whole history.
measurementDateArgs=()
historyDateArgs=()

# Export limits. Checked before anything is written; --ignoreLimits overrides
# them with a warning.
MAX_CHILD_OBJECTS=25
MAX_MEASUREMENTS_PER_DEVICE=1000000
MAX_EVENTS_PER_DEVICE=1000
MAX_ALARMS_PER_DEVICE=1000
DEFAULT_MEASUREMENT_DATE_FROM=-14d

# Ids the export will visit, collected by the pre-flight traversal
plannedIds=" "

# Exceeded limits, one tab separated row each: kind, subject, actual, allowed
violationRows=""

# Which device held the highest count for each exceeded limit
worstNote=""

# The window the suggestion was scaled from
currentWindow=""

# Every file this run wrote, so a partial export can be removed precisely
# rather than by deleting the output directory, which may not be ours
artifacts=()
createdOutputDirectory=""

# --ignoreLimits, resolved once so the limit helpers do not each reach for the
# parser variables
ignoreLimits=false

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
resolve_data_types() {
    local requested dataType

    requested="${__dataTypes:-}"
    if [[ -z "${requested// /}" ]]; then
        dataTypes=""
        return 0
    fi

    dataTypes=$(printf '%s' "$requested" | tr ',' ' ')

    # shellcheck disable=2086
    for dataType in $dataTypes; do
        case "$dataType" in
            measurements|events|alarms) ;;
            operations)
                echo "Operations are not migrated: they cannot be created with a status, so every" >&2
                echo "recreated operation would be PENDING and the target device would execute it" >&2
                exit 1
                ;;
            *)
                echo "Unsupported data type '$dataType', expected measurements, events or alarms" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "${dataTypes// /}" ]]; then
        echo "No data types given, expected a comma separated list of measurements, events or alarms" >&2
        exit 1
    fi
}

# shellcheck disable=SC2154
resolve_date_args() {
    if [[ -n "$__dateFrom" ]]; then
        historyDateArgs+=(--dateFrom "$__dateFrom")
    fi
    if [[ -n "$__dateTo" ]]; then
        historyDateArgs+=(--dateTo "$__dateTo")
    fi

    # Measurements inherit whatever window was asked for, and fall back to the
    # default 14 days when no --dateFrom was given.
    measurementDateArgs=("${historyDateArgs[@]}")
    if [[ -z "$__dateFrom" ]]; then
        measurementDateArgs+=(--dateFrom "$DEFAULT_MEASUREMENT_DATE_FROM")
    fi
}

# Is one data type requested?
wants_data() {
    [[ " $dataTypes " == *" $1 "* ]]
}

# Name of a managed object as it appears in the export, for logging only
read_name() {
    local name
    # -j so no trailing newline is turned into a trailing space by tr
    name=$(jq -rj '.name // empty' "$1" | tr '\t\n' '  ')
    if [[ -z "${name// /}" ]]; then
        name="<unnamed>"
    fi
    printf '%s' "$name"
}

report_totals() {
    local line

    line="Exported $exportedCount $(plural "$exportedCount" "managed object" "managed objects")"
    line+=" and $identityCount $(plural "$identityCount" "external identity" "external identities")"

    if [[ -n "${dataTypes// /}" ]]; then
        line+=", with $measurementCount $(plural "$measurementCount" measurement measurements)"
        line+=", $eventCount $(plural "$eventCount" event events)"
        line+=" and $alarmCount $(plural "$alarmCount" alarm alarms)"
        if [[ "$binaryCount" -gt 0 ]]; then
            line+=" including $binaryCount $(plural "$binaryCount" attachment attachments)"
        fi
    fi

    echo "$line to $1" >&2
}

plural() {
    if [[ "$1" -eq 1 ]]; then
        printf '%s' "$2"
    else
        printf '%s' "$3"
    fi
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
resolve_child_types() {
    local requested childType

    # --no-children exports the root on its own, so nothing is traversed. An
    # empty childTypes makes the loop over child types below iterate zero times.
    if [[ "$__no_children" == "true" ]]; then
        childTypes=""
        return 0
    fi

    requested="${__childTypes:-asset,device}"
    childTypes=$(printf '%s' "$requested" | tr ',' ' ')

    # shellcheck disable=2086
    for childType in $childTypes; do
        case "$childType" in
            asset|device|addition) ;;
            *)
                echo "Unsupported child type '$childType', expected asset, device or addition" >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "${childTypes// /}" ]]; then
        echo "No child types given, expected a comma separated list of asset, device or addition" >&2
        exit 1
    fi
}

# Device data for one device, written as NDJSON under data/<id>/. Records are
# written verbatim: import decides what to strip, exactly as it does for the
# managed objects themselves. Keeping the record ids is also what makes event
# attachments correlatable.
#
# Returns nothing; appends to the per-type totals and echoes a summary fragment.
# --- limits ----------------------------------------------------------------
#
# Counted before anything is written, so the normal refusal leaves nothing
# behind at all. The during-export check further down is the backstop for data
# that grew between the count and the fetch.

# Walks the hierarchy collecting ids, without writing anything and without
# fetching the objects themselves.
collect_planned_ids() {
    local deviceId="$1"
    local childType children childId

    if [[ "$plannedIds" == *" $deviceId "* ]]; then
        return 0
    fi
    plannedIds+="$deviceId "

    # shellcheck disable=2086
    for childType in $childTypes; do
        children=$(c8y inventory children list --childType "$childType" \
            --id "$deviceId" --select id --nullInput)
        [[ -n "$children" ]] || continue

        while IFS= read -r childId; do
            [[ -n "$childId" ]] || continue
            collect_planned_ids "$childId" < /dev/null
        done < <(printf '%s\n' "$children" | jq -r '.id')
    done
}

# How many records a device holds, without fetching them. --withTotalElements
# needs 10.13 or newer, so totalPages is the fallback: with a page size of one
# it equals the record count.
count_records() {
    local kind="$1" deviceId="$2"
    local response total
    local -a windowArgs

    if [[ "$kind" == "measurements" ]]; then
        windowArgs=("${measurementDateArgs[@]}")
    else
        windowArgs=("${historyDateArgs[@]}")
    fi

    response=$(c8y "$kind" list --device "$deviceId" "${windowArgs[@]}" \
        --pageSize 1 --withTotalElements --withTotalPages --raw --nullInput)
    total=$(printf '%s' "$response" \
        | jq -r '.statistics.totalElements // .statistics.totalPages // empty')
    printf '%s' "${total:-0}"
}

# One row per exceeded limit: kind, what it applies to, actual, allowed.
record_violation() {
    violationRows+="$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\n'
}

# The window that would bring a count within its limit, scaled linearly from
# the window actually used. Only whole days and weeks are understood; anything
# else returns nothing and the suggestion is simply omitted.
window_in_days() {
    local value="$1" number
    case "$value" in
        -[0-9]*d) number=${value%d}; printf '%s' "${number#-}" ;;
        -[0-9]*w) number=${value%w}; printf '%s' $(( ${number#-} * 7 )) ;;
        *) printf '' ;;
    esac
}

suggest_window() {
    local actual="$1" limit="$2" days="$3" scaled

    scaled=$(( days * limit / actual ))
    if [[ "$scaled" -lt 1 ]]; then
        scaled=1
    fi
    printf '%s' "$scaled"
}

# shellcheck disable=SC2154
report_violations() {
    local kind label affected highest limit worst
    local window days required tightest="" tightestKind=""

    echo "Export limits exceeded:" >&2
    echo "" >&2
    printf '  %-22s %8s %14s %14s\n' "limit" "devices" "highest" "allowed" >&2
    printf '  %-22s %8s %14s %14s\n' \
        "----------------------" "--------" "--------------" "--------------" >&2

    # One row per limit rather than per device: every device is still checked,
    # but a wide hierarchy would otherwise produce hundreds of near identical
    # lines. The worst count per limit is what a narrower window has to fit.
    while IFS=$'\t' read -r kind affected highest limit worst; do
        [[ -n "$kind" ]] || continue

        label=$kind
        if [[ "$kind" == "children" ]]; then
            label="child objects"
            affected="-"
        fi

        printf '  %-22s %8s %14s %14s\n' \
            "$label" "$affected" "$highest" "$limit" >&2

        if [[ -n "$worst" && "$kind" != "children" ]]; then
            worstNote+="  $kind: highest on device $worst"$'\n'
        fi

        # What window would bring this count inside its limit? Measurements
        # always have one, defaulting to 14 days. Events and alarms only have a
        # window if the caller gave one, since they default to all history.
        window=""
        case "$kind" in
            measurements) window="${__dateFrom:-$DEFAULT_MEASUREMENT_DATE_FROM}" ;;
            events|alarms) window="${__dateFrom:-}" ;;
        esac
        [[ -n "$window" ]] || continue

        days=$(window_in_days "$window")
        [[ -n "$days" ]] || continue

        required=$(suggest_window "$highest" "$limit" "$days")
        # --dateFrom is a single flag covering every type, so the suggestion has
        # to be the tightest of them
        if [[ -z "$tightest" || "$required" -lt "$tightest" ]]; then
            tightest=$required
            tightestKind=$kind
            currentWindow=$window
        fi
    done < <(awk -F'\t' '
        $1 == "children"     { rank[$1] = 1 }
        $1 == "measurements" { rank[$1] = 2 }
        $1 == "events"       { rank[$1] = 3 }
        $1 == "alarms"       { rank[$1] = 4 }
        $1 != "" {
            seen[$1]++
            allowed[$1] = $4
            if ($3 + 0 > highest[$1]) { highest[$1] = $3 + 0; worst[$1] = $2 }
        }
        END {
            for (k in seen) {
                printf "%s\t%s\t%s\t%s\t%s\t%s\n", \
                    rank[k], k, seen[k], highest[k], allowed[k], worst[k]
            }
        }' <<< "$violationRows" | LC_ALL=C sort -n | cut -f2-)

    if [[ -n "$worstNote" ]]; then
        echo "" >&2
        printf '%s' "$worstNote" >&2
    fi

    if [[ -n "$tightest" ]]; then
        echo "" >&2
        echo "Try --dateFrom -${tightest}d, which would bring $tightestKind within their" >&2
        echo "limit (the window is currently $currentWindow)." >&2
    fi
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
check_limits() {
    local rootId="$1"
    local childObjects deviceId total

    collect_planned_ids "$rootId"

    # the root itself is not a child
    childObjects=$(( $(printf '%s' "$plannedIds" | wc -w) - 1 ))
    if [[ "$childObjects" -gt "$MAX_CHILD_OBJECTS" ]]; then
        record_violation children "-" "$childObjects" "$MAX_CHILD_OBJECTS"
    fi

    # Every limit is checked for every device before anything is reported, so
    # one run tells the whole story rather than stopping at the first problem.
    # shellcheck disable=2086
    for deviceId in $plannedIds; do
        if wants_data measurements; then
            total=$(count_records measurements "$deviceId")
            if [[ "$total" -gt "$MAX_MEASUREMENTS_PER_DEVICE" ]]; then
                record_violation measurements "$deviceId" "$total" "$MAX_MEASUREMENTS_PER_DEVICE"
            fi
        fi
        if wants_data events; then
            total=$(count_records events "$deviceId")
            if [[ "$total" -gt "$MAX_EVENTS_PER_DEVICE" ]]; then
                record_violation events "$deviceId" "$total" "$MAX_EVENTS_PER_DEVICE"
            fi
        fi
        if wants_data alarms; then
            total=$(count_records alarms "$deviceId")
            if [[ "$total" -gt "$MAX_ALARMS_PER_DEVICE" ]]; then
                record_violation alarms "$deviceId" "$total" "$MAX_ALARMS_PER_DEVICE"
            fi
        fi
    done

    if [[ -z "$violationRows" ]]; then
        return 0
    fi

    report_violations

    if [[ "$ignoreLimits" == "true" ]]; then
        echo "" >&2
        echo "Exporting anyway because --ignoreLimits was given." >&2
        return 0
    fi

    echo "" >&2
    echo "Nothing was exported. Narrow the export with --childTypes, --dataTypes" >&2
    echo "or --dateFrom, or pass --ignoreLimits to export regardless." >&2
    exit 1
}

warn_ignoring_limits() {
    local bold="" reset=""

    # bold only at a terminal, so piped and captured output stays clean
    if [[ -t 2 ]]; then
        bold=$'\033[1m'
        reset=$'\033[0m'
    fi

    echo "${bold}WARNING: --ignoreLimits is set, so the export limits are not enforced.${reset}" >&2
    echo "${bold}An unbounded export can take a very long time and produce a very large${reset}" >&2
    echo "${bold}result. It can also put avoidable load on the source tenant.${reset}" >&2
}

# --- partial export cleanup ------------------------------------------------

record_artifact() {
    artifacts+=("$1")
}

# Removes exactly what this run wrote. The output directory itself is only
# deleted when this run created it: --output-directory may point at a directory
# holding unrelated files, and those are not ours to remove.
revert_partial_export() {
    local index path

    for (( index = ${#artifacts[@]} - 1; index >= 0; index-- )); do
        rm -f "${artifacts[$index]}"
    done

    if [[ -n "$createdOutputDirectory" && -d "$createdOutputDirectory" ]]; then
        rm -rf "$createdOutputDirectory"
        return 0
    fi

    # a pre-existing directory: take away only the empty shells we left
    for path in "${artifacts[@]}"; do
        while [[ "$path" == */* ]]; do
            path=${path%/*}
            rmdir "$path" 2>/dev/null || break
        done
    done
}

abort_export() {
    echo "$1" >&2
    revert_partial_export
    echo "The partial export was removed." >&2
    exit 1
}

# Backstop for data that grew between the pre-flight count and the fetch.
enforce_record_limit() {
    local kind="$1" limit="$2" deviceId="$3" count="$4"

    if [[ "$ignoreLimits" == "true" ]]; then
        return 0
    fi
    if [[ "$count" -le "$limit" ]]; then
        return 0
    fi

    abort_export "Device $deviceId returned $count $kind, more than the limit of $limit"
}

export_device_data() {
    local deviceId="$1" outputDirectory="$2"
    local dataDirectory="${outputDirectory}/data/${deviceId}"
    local count

    dataSummary=""

    if [[ -z "${dataTypes// /}" ]]; then
        return 0
    fi

    if wants_data measurements; then
        mkdir -p "$dataDirectory"
        c8y measurements list --device "$deviceId" "${measurementDateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/measurements.jsonl"
        count=$(grep -c '' < "${dataDirectory}/measurements.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/measurements.jsonl"
        else
            record_artifact "${dataDirectory}/measurements.jsonl"
            enforce_record_limit measurements \
                "$MAX_MEASUREMENTS_PER_DEVICE" "$deviceId" "$count"
            measurementCount=$((measurementCount + count))
            dataSummary+=", $count $(plural "$count" measurement measurements)"
        fi
    fi

    if wants_data events; then
        mkdir -p "$dataDirectory"
        c8y events list --device "$deviceId" "${historyDateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/events.jsonl"
        count=$(grep -c '' < "${dataDirectory}/events.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/events.jsonl"
        else
            record_artifact "${dataDirectory}/events.jsonl"
            enforce_record_limit events \
                "$MAX_EVENTS_PER_DEVICE" "$deviceId" "$count"
            eventCount=$((eventCount + count))
            dataSummary+=", $count $(plural "$count" event events)"
            export_event_binaries "$dataDirectory"
        fi
    fi

    if wants_data alarms; then
        mkdir -p "$dataDirectory"
        c8y alarms list --device "$deviceId" "${historyDateArgs[@]}" \
            --includeAll --nullInput > "${dataDirectory}/alarms.jsonl"
        count=$(grep -c '' < "${dataDirectory}/alarms.jsonl" || true)
        if [[ "$count" -eq 0 ]]; then
            rm -f "${dataDirectory}/alarms.jsonl"
        else
            record_artifact "${dataDirectory}/alarms.jsonl"
            enforce_record_limit alarms \
                "$MAX_ALARMS_PER_DEVICE" "$deviceId" "$count"
            alarmCount=$((alarmCount + count))
            dataSummary+=", $count $(plural "$count" alarm alarms)"
        fi
    fi

    # leave no empty directory behind for a device with no data at all
    rmdir "$dataDirectory" 2>/dev/null || true
}

# Downloads the attachment of every event that has one. Events carrying a
# binary are marked with a c8y_IsBinary fragment, so only those cost a request.
export_event_binaries() {
    local dataDirectory="$1"
    local eventId count=0

    while IFS= read -r eventId; do
        [[ -n "$eventId" ]] || continue
        mkdir -p "${dataDirectory}/binaries"
        c8y events downloadBinary --id "$eventId" \
            --outputFileRaw "${dataDirectory}/binaries/${eventId}" --nullInput > /dev/null
        record_artifact "${dataDirectory}/binaries/${eventId}"
        count=$((count + 1))
    done < <(jq -r 'select(has("c8y_IsBinary")) | .id' "${dataDirectory}/events.jsonl")

    if [[ "$count" -gt 0 ]]; then
        binaryCount=$((binaryCount + count))
        dataSummary+=", $count $(plural "$count" attachment attachments)"
    fi
}

export_device_recursive() {
    local deviceId="$1"
    local outputDirectory="$2"

    if [[ "$exported_ids" == *" $deviceId "* ]]; then
        return 0
    fi
    exported_ids+="$deviceId "

    # Export the current device. Its stdout is discarded: what the caller wants
    # to read is the progress line below, not the raw managed object.
    c8y inventory get --id "$deviceId" \
        --outputFileRaw "${outputDirectory}/exported_device_$deviceId.json" \
        --nullInput > /dev/null
    record_artifact "${outputDirectory}/exported_device_$deviceId.json"

    local name
    name=$(read_name "${outputDirectory}/exported_device_$deviceId.json")

    # External identities bound to the device. Written as a JSON array so the
    # file matches its extension, and only when the device actually has any.
    local identities identityFile deviceIdentities=0
    identities=$(c8y identity list --device "$deviceId" --select externalId,type --nullInput)
    if [[ -n "$identities" ]]; then
        identityFile="${outputDirectory}/${deviceId}_identities.json"
        printf '%s\n' "$identities" | jq -s 'map({type, externalId})' > "$identityFile"
        record_artifact "$identityFile"
        deviceIdentities=$(jq 'length' "$identityFile")
        identityCount=$((identityCount + deviceIdentities))
    fi

    # Children are gathered for every requested type before descending, so the
    # progress line for this device is complete and the output reads top down
    # rather than depth first.
    local childType children indexFile count summary="" pending=""
    # shellcheck disable=2086
    for childType in $childTypes; do
        # --nullInput so c8y never consumes the child ID list driving the loop
        # below, which would cut the traversal short after the first child
        children=$(c8y inventory children list --childType "$childType" --id "$deviceId" --select id --nullInput)

        if [[ -z "$children" ]]; then
            continue
        fi

        # Save child IDs to separate file per child type, as a JSON array so the
        # file matches its extension and a rerun replaces it instead of appending
        indexFile="${outputDirectory}/${deviceId}_child_${childType}.json"
        printf '%s\n' "$children" | jq -s 'map(.id)' > "$indexFile"
        record_artifact "$indexFile"

        count=$(jq 'length' "$indexFile")
        summary+=", $count $childType $(plural "$count" child children)"
        pending+="$(jq -r '.[]' "$indexFile")"$'\n'
    done

    if [[ "$deviceIdentities" -gt 0 ]]; then
        summary+=", $deviceIdentities $(plural "$deviceIdentities" identity identities)"
    fi

    export_device_data "$deviceId" "$outputDirectory"
    summary+="$dataSummary"

    exportedCount=$((exportedCount + 1))
    echo "Exported $name ($deviceId)$summary" >&2

    local childId
    while IFS= read -r childId; do
        if [[ -n "$childId" ]]; then
            export_device_recursive "$childId" "$outputDirectory" < /dev/null
        fi
    done <<< "$pending"
}

# The __* variables are set by the generated parser through eval, which
# this linter cannot follow.
# shellcheck disable=SC2154
run_export() {
    eval "$(docopt "$@")"

    resolve_child_types
    resolve_data_types
    resolve_date_args

    ignoreLimits="$__ignoreLimits"
    if [[ "$ignoreLimits" == "true" ]]; then
        warn_ignoring_limits
    fi

    # Before anything is written, so a refusal leaves nothing behind
    check_limits "$__rootId"

    if [[ -n "$__output_directory" ]]; then
        # remembered so a partial export can delete a directory it created,
        # while leaving a pre-existing one in place
        if [[ ! -d "$__output_directory" ]]; then
            createdOutputDirectory="$__output_directory"
        fi
        mkdir -p "$__output_directory"
        export_device_recursive "$__rootId" "$__output_directory"
        report_totals "$__output_directory"
        return 0
    fi

    # --output-compressed: collect the export in a staging directory, then archive it
    local stagingDirectory
    stagingDirectory=$(mktemp -d)
    # shellcheck disable=2064
    trap "rm -rf '$stagingDirectory'" EXIT

    export_device_recursive "$__rootId" "$stagingDirectory"
    tar -czf "$__output_compressed" -C "$stagingDirectory" .
    report_totals "$__output_compressed"
}

run_export "$@"
