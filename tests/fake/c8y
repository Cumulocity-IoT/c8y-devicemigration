#!/usr/bin/env bash
#
# Fake go-c8y-cli, used so the test suite never touches a real tenant.
#
# ASSUMPTIONS THIS FAKE ENCODES about real c8y behaviour. If one of these is
# wrong, the suite is green and the code is still broken, so each is noted with
# how far it has actually been verified:
#
#   1. Commands that accept pipeline input READ STDIN when stdin is not a TTY
#      and --nullInput/-n was not passed. VERIFIED indirectly, and painfully:
#      in production `inventory children assign` drained the pipe feeding a
#      while-read loop, so only the first child of each parent was assigned.
#      This is modelled below and is the single most important line in here.
#   2. `inventory children list --select id` emits newline-delimited
#      {"id":"..."} objects, not a JSON array. VERIFIED against a live tenant.
#   3. `inventory create --select id` emits {"id":"<new id>"}. VERIFIED against
#      a live tenant: a real import reported "Imported L1 (1474379857 ->
#      229986056)", so jq did extract an id from the create output. A different
#      shape would have left newId empty and aborted the import.
#   4. A plain-JSON file passed to --template is used as the request body
#      verbatim (JSON being a subset of jsonnet). VERIFIED against a live
#      tenant: the objects a real import created carried their original names,
#      which only happens if the template reached the request body.
#
#      Corollary and a real limit of this fake: it does NOT evaluate jsonnet.
#      For the data create commands it records the piped record and the
#      --template string separately, so a test can assert that the template
#      hides the server managed properties, but not that the resulting body
#      lacks them. Verifying the evaluated body needs a live tenant.
#   5. `inventory get` fails with a non-zero exit code for an id that does not
#      exist. VERIFIED against a live tenant: it exits 4, which go-c8y-cli
#      defines as ExitNotFound404. revert only tests success or failure, so the
#      specific code does not matter, but any non-zero value is required for it
#      to tell an absent object from a present one.
#   6. Deleting a managed object also removes its external identities, so
#      revert does not delete them separately. VERIFIED against a live tenant.
#
# Creating external identities on import has also been confirmed against a live
# tenant, so every command path in this extension has run for real at least once.
#
# Two id spaces are in play, which is why `inventory get` has two sources:
# the hierarchy fixture is the SOURCE tenant that export reads, and objects
# created under $FAKE_C8Y_REC/objects are the TARGET tenant that import writes
# and revert deletes.
#
# Required env:
#   FAKE_C8Y_REC        directory to record calls into
#
# Optional env:
#   FAKE_C8Y_HIERARCHY      path to a hierarchy.json describing the source tenant
#   FAKE_C8Y_FAIL_CREATE    when set, every `inventory create` emits no id
#   FAKE_C8Y_FAIL_CREATE_NAME  fail `inventory create` only for this object name,
#                           to model an import dying part way through
#   FAKE_C8Y_FAIL_IDENTITY  external id that `identity create` rejects, standing
#                           in for one the target tenant already knows
#   FAKE_C8Y_FAIL_DELETE    id whose deletion fails
#   FAKE_C8Y_TOTAL_MEASUREMENTS, FAKE_C8Y_TOTAL_EVENTS, FAKE_C8Y_TOTAL_ALARMS
#                           counts reported to a pre-flight count query,
#                           overriding what the fixture actually holds. Lets a
#                           test drive export's limit checks without generating
#                           a million records.
#   FAKE_C8Y_CONFIRM        stands in for the answer a user gives to c8y's own
#                           confirmation dialog when --force was not passed.
#                           "yes" or "a" proceeds, anything else (the default)
#                           declines and nothing is deleted, mirroring how c8y
#                           aborts on a refusal. Real c8y reads this from the
#                           terminal, which a test cannot provide.
#   FAKE_C8Y_CASCADE        "<parent>:<child>,<child>" - deleting <parent> also
#                           removes those ids, modelling group propagation
#
# Recorded into $FAKE_C8Y_REC:
#   calls.log       one line per invocation: <subcommand>\t<stdin drained?>\t<argv>
#   links.log       "<parentId> <childType> <childId>" per children assign
#   identities.log  "<deviceId> <type> <externalId>" per identity create
#   deletes.log     "<id>" per successful inventory delete
#   payloads/       the --template body of each create, named by the new id
#   objects/        the target tenant: one file per live created object
#   counter         last allocated id

set -e

: "${FAKE_C8Y_REC:?FAKE_C8Y_REC must be set}"
mkdir -p "$FAKE_C8Y_REC/payloads" "$FAKE_C8Y_REC/objects"

argv=("$@")

# --- assumption 1: pipeline input consumption -------------------------------
# Real c8y reads stdin unless told not to. If the caller forgot --nullInput and
# stdin happens to be the pipe driving its own loop, that loop dies after one
# iteration. Model it exactly, and record whether it happened.
nullInput=no
force=no
silentExit=no
countQuery=no
for a in "${argv[@]}"; do
    if [[ "$a" == "--nullInput" || "$a" == "-n" ]]; then
        nullInput=yes
    fi
    if [[ "$a" == "--force" || "$a" == "-f" ]]; then
        force=yes
    fi
    # --silentExit zeroes the exit code for ANY error, not only for codes named
    # in --silentStatusCodes. Verified in go-c8y-cli pkg/cmdutil/factory.go,
    # where GetSilentExit() nils the returned error unconditionally.
    if [[ "$a" == "--silentExit" ]]; then
        silentExit=yes
    fi
    # a count query rather than a data fetch
    if [[ "$a" == "--withTotalElements" || "$a" == "--withTotalPages" ]]; then
        countQuery=yes
    fi
done

# real c8y suppresses the error message for status codes listed here
silent404=no
if [[ "${*}" == *"--silentStatusCodes"* ]]; then
    for a in "${argv[@]}"; do
        if [[ "$a" == *404* ]]; then
            silent404=yes
        fi
    done
fi

# Captured rather than discarded, because some commands legitimately take their
# records on stdin: --device is the pipeline target on every create command.
# `drained` is still recorded either way, so the "nothing reads stdin by
# accident" invariant can be asserted for the commands where it applies.
drained=no
stdinFile="$FAKE_C8Y_REC/stdin.$$"
: > "$stdinFile"
if [[ "$nullInput" == "no" ]] && [[ ! -t 0 ]]; then
    cat > "$stdinFile"
    drained=yes
fi
# ---------------------------------------------------------------------------

subcommand="$1 $2 $3"
id=""; child=""; childType=""; outputFileRaw=""; template=""
device=""; externalType=""; externalId=""; ids=()
file=""; batchSize=""; processingMode=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --id) id="$2"; ids+=("$2"); shift 2 ;;
        --child) child="$2"; shift 2 ;;
        --childType) childType="$2"; shift 2 ;;
        --outputFileRaw) outputFileRaw="$2"; shift 2 ;;
        --template) template="$2"; shift 2 ;;
        --device) device="$2"; shift 2 ;;
        --type) externalType="$2"; shift 2 ;;
        --name) externalId="$2"; shift 2 ;;
        --file) file="$2"; shift 2 ;;
        --batchSize) batchSize="$2"; shift 2 ;;
        --processingMode) processingMode="$2"; shift 2 ;;
        *) shift ;;
    esac
done

printf '%s\t%s\t%s\n' "$subcommand" "$drained" "${argv[*]}" >> "$FAKE_C8Y_REC/calls.log"

hierarchy() {
    : "${FAKE_C8Y_HIERARCHY:?FAKE_C8Y_HIERARCHY must be set}"
    jq "$@" --arg id "$id" --arg childType "$childType" "$FAKE_C8Y_HIERARCHY"
}

emit() {
    # Real c8y writes the raw response to --outputFileRaw AND still renders it
    # on stdout. Reproducing that is what lets a test notice if a caller stops
    # suppressing it and starts spewing whole managed objects at the operator.
    if [[ -n "$outputFileRaw" ]]; then
        tee "$outputFileRaw"
    else
        cat
    fi
}

case "$subcommand" in
    "inventory get "*)
        inHierarchy=no
        if [[ -n "${FAKE_C8Y_HIERARCHY:-}" ]]; then
            # shellcheck disable=SC2016  # $id is a jq variable bound with --arg
            if [[ "$(hierarchy -r 'has($id)')" == "true" ]]; then
                inHierarchy=yes
            fi
        fi

        if [[ -f "$FAKE_C8Y_REC/objects/$id.json" ]]; then
            # an object this run created: the target tenant
            emit < "$FAKE_C8Y_REC/objects/$id.json"
        elif [[ "$inHierarchy" == "yes" ]]; then
            # Emit a managed object shaped like a real one: the caller's data
            # plus the server managed properties that import is expected to
            # strip. $id below is a jq variable bound with --arg.
            # shellcheck disable=SC2016
            hierarchy '
                .[$id] as $o
                | {
                    id: $id,
                    self: ("https://example.cumulocity.com/inventory/managedObjects/" + $id),
                    lastUpdated: "2026-01-01T00:00:00.000Z",
                    creationTime: "2025-01-01T00:00:00.000Z",
                    owner: "service_test",
                    type: $o.type,
                    childDevices: { self: "x", references: [] },
                    childAssets: { self: "x", references: [] },
                    childAdditions: { self: "x", references: [] },
                    deviceParents: { references: [] },
                    assetParents: { references: [] },
                    additionParents: { references: [] },
                    c8y_Availability: { status: "AVAILABLE" },
                    c8y_ActiveAlarmsStatus: { critical: 1 },
                    c8y_IsDevice: {},
                    "my_Custom-Fragment": { nested: { keep: true } }
                  }
                + (if $o.name then { name: $o.name } else {} end)
            ' | emit
        else
            # assumption 5
            echo "fake c8y: managed object $id not found" >&2
            if [[ "$silentExit" == "yes" ]]; then
                exit 0
            fi
            exit 1
        fi
        ;;

    "inventory children list")
        # assumption 2: newline delimited objects, one per child.
        # $id and $childType are jq variables bound with --arg.
        # shellcheck disable=SC2016
        hierarchy -r '(.[$id].children[$childType] // [])[] | {id: .} | tojson'
        ;;

    "identity list"*)
        # newline delimited, one per external id, mirroring inventory children
        # list. $device is a jq variable bound with --arg.
        # shellcheck disable=SC2016
        jq -r --arg device "$device" \
            '(.[$device].identities // [])[] | {externalId, type} | tojson' \
            "${FAKE_C8Y_HIERARCHY:?}"
        ;;

    "inventory create"*)
        if [[ -n "${FAKE_C8Y_FAIL_CREATE:-}" ]]; then
            exit 0
        fi
        if [[ -n "${FAKE_C8Y_FAIL_CREATE_NAME:-}" && -n "$template" ]] && \
           [[ "$(jq -r '.name // empty' "$template")" == "${FAKE_C8Y_FAIL_CREATE_NAME}" ]]; then
            exit 0
        fi
        counter=$(cat "$FAKE_C8Y_REC/counter" 2>/dev/null || echo 1000)
        counter=$((counter + 1))
        echo "$counter" > "$FAKE_C8Y_REC/counter"
        if [[ -n "$template" ]]; then
            cp "$template" "$FAKE_C8Y_REC/payloads/$counter.json"
            # the object now lives in the target tenant
            jq --arg id "$counter" '. + {id: $id}' "$template" \
                > "$FAKE_C8Y_REC/objects/$counter.json"
        fi
        # assumption 3
        printf '{"id":"%s"}\n' "$counter"
        ;;

    "inventory delete"*)
        # c8y confirms each request unless --force was passed, reading the
        # answer from the terminal. A declined confirmation aborts the run.
        if [[ "$force" == "no" ]]; then
            # Real c8y RENDERS THE DIALOG ON STDERR. Emitting it here is what
            # lets a test notice if the caller ever redirects stderr away: doing
            # so hides the prompt and the command appears to hang.
            printf 'Confirm (job: 1)\n[y] Yes  [a] Yes to All  [n] No  [l] No to All\n' >&2
            case "${FAKE_C8Y_CONFIRM:-no}" in
                yes|y|a|yestoall) ;;
                *)
                    echo "fake c8y: User did not confirm action" >&2
                    exit 1
                    ;;
            esac
        fi

        deleteFailed=no
        for target in "${ids[@]}"; do
            if [[ -n "${FAKE_C8Y_FAIL_DELETE:-}" && "$target" == "${FAKE_C8Y_FAIL_DELETE}" ]]; then
                echo "fake c8y: refusing to delete $target" >&2
                deleteFailed=yes
                continue
            fi
            if [[ ! -f "$FAKE_C8Y_REC/objects/$target.json" ]]; then
                # Already gone, most likely propagation from a deleted parent.
                # Real c8y reports this as a 404 on stderr and counts it as a
                # job error, unless the status code was silenced.
                if [[ "$silent404" == "no" ]]; then
                    echo "serverError: No managedObject for id '$target'! DELETE .../inventory/managedObjects/$target: 404 inventory/Not Found" >&2
                    deleteFailed=yes
                fi
                continue
            fi
            rm -f "$FAKE_C8Y_REC/objects/$target.json"
            echo "$target" >> "$FAKE_C8Y_REC/deletes.log"

            # model group propagation: deleting a parent takes listed ids with it
            if [[ -n "${FAKE_C8Y_CASCADE:-}" ]]; then
                cascadeParent=${FAKE_C8Y_CASCADE%%:*}
                if [[ "$target" == "$cascadeParent" ]]; then
                    cascadeChildren=${FAKE_C8Y_CASCADE#*:}
                    for c in ${cascadeChildren//,/ }; do
                        rm -f "$FAKE_C8Y_REC/objects/$c.json"
                    done
                fi
            fi
        done
        if [[ "$deleteFailed" == "yes" ]]; then
            exit 1
        fi
        ;;

    "identity create"*)
        if [[ -n "${FAKE_C8Y_FAIL_IDENTITY:-}" && "$externalId" == "${FAKE_C8Y_FAIL_IDENTITY}" ]]; then
            echo "fake c8y: external id $externalId already exists" >&2
            exit 1
        fi
        printf '%s %s %s\n' "$device" "$externalType" "$externalId" >> "$FAKE_C8Y_REC/identities.log"
        printf '{"externalId":"%s","type":"%s"}\n' "$externalId" "$externalType"
        ;;

    "measurements list"*|"events list"*|"alarms list"*)
        dataKind=${subcommand%% *}

        if [[ "$countQuery" == "yes" ]]; then
            # A pre-flight count: the real CLI returns the response envelope
            # with .statistics when --raw is combined with --withTotalElements.
            case "$dataKind" in
                measurements) total="${FAKE_C8Y_TOTAL_MEASUREMENTS:-}" ;;
                events) total="${FAKE_C8Y_TOTAL_EVENTS:-}" ;;
                alarms) total="${FAKE_C8Y_TOTAL_ALARMS:-}" ;;
            esac
            if [[ -z "$total" ]]; then
                # shellcheck disable=SC2016
                total=$(jq -r --arg device "$device" --arg kind "$dataKind" \
                    '(.[$device][$kind] // []) | length' "${FAKE_C8Y_HIERARCHY:?}")
            fi
            printf '{"statistics":{"totalElements":%s,"totalPages":%s},"%s":[]}\n' \
                "$total" "$total" "$dataKind"
            exit 0
        fi

        # newline delimited records straight from the hierarchy fixture, which
        # is what the real list commands emit when piped.
        # $device is a jq variable bound with --arg.
        # shellcheck disable=SC2016
        jq -r --arg device "$device" --arg kind "$dataKind" \
            '(.[$device][$kind] // [])[] | tojson' "${FAKE_C8Y_HIERARCHY:?}"
        ;;

    "measurements createBulk "*)
        # Records arrive on stdin. Grouping into batches is the whole point of
        # this command, so the batch size is recorded for assertions.
        recordCount=$(grep -c '' < "$stdinFile" || true)
        printf '%s %s %s\n' "$device" "$recordCount" "${batchSize:-none}" \
            >> "$FAKE_C8Y_REC/measurements.log"
        printf 'processingMode=%s\n' "${processingMode:-none}" \
            >> "$FAKE_C8Y_REC/processing-modes.log"
        ;;

    "measurements create "*|"events create "*|"alarms create "*)
        dataKind=${subcommand%% *}
        printf 'processingMode=%s\n' "${processingMode:-none}" \
            >> "$FAKE_C8Y_REC/processing-modes.log"
        # one line recorded per piped record, with the body it would have sent
        while IFS= read -r record; do
            [[ -n "$record" ]] || continue
            printf '%s\t%s\t%s\t%s\n' "$dataKind" "$device" "$record" "$template" \
                >> "$FAKE_C8Y_REC/$dataKind.log"
            # a created record gets a fresh id, as the real API would assign
            counter=$(cat "$FAKE_C8Y_REC/counter" 2>/dev/null || echo 1000)
            counter=$((counter + 1))
            echo "$counter" > "$FAKE_C8Y_REC/counter"
            printf '{"id":"%s"}\n' "$counter"
        done < "$stdinFile"
        ;;

    "events downloadBinary"*)
        printf 'attachment of event %s\n' "$id" | emit
        printf '%s\n' "$id" >> "$FAKE_C8Y_REC/binaries-downloaded.log"
        ;;

    "events createBinary"*)
        printf '%s %s\n' "$id" "$file" >> "$FAKE_C8Y_REC/binaries-uploaded.log"
        printf '{"id":"%s"}\n' "$id"
        ;;

    "inventory children assign")
        printf '%s %s %s\n' "$id" "$childType" "$child" >> "$FAKE_C8Y_REC/links.log"
        printf '{"id":"%s"}\n' "$id"
        ;;

    *)
        echo "fake c8y: unhandled subcommand: $subcommand" >&2
        exit 1
        ;;
esac
